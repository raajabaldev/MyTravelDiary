# Copy this file to .env and fill in your Supabase project credentials.
# Keep your journal private by disabling public signups in Supabase Auth
# and creating your single personal user in the Supabase Dashboard.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

